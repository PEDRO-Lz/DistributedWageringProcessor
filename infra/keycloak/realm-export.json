{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Sistemas de apostas autorizados a submeter wager transactions"
      }
    ]
  },
  "clients": [
    {
      "clientId": "wagering-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wagering-api-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "wagering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wagering-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-wagering-api",
      "enabled": true,
      "serviceAccountClientId": "wagering-api",
      "realmRoles": ["provider"]
    }
  ]
}
